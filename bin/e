#!/bin/bash

function do_local()
{
    if super.py has_emacs
    then
        # there is already an emacs frame on this desktop, just use it.
        # Make sure that the right frame is in focus, so that emacsclient just
        # uses it.
        super.py emacs
        emacsclient -n -e "(other-window 1)" > /dev/null
        emacsclient -n "$@"
    elif emacsclient -e '(version)' &>/dev/null
    then
        # there is an emacs server but no frame on this desktop. Create a new
        # one
        emacsclient -c -n "$@"
    else
        # start a new emacs
        emacs "$@" &
    fi
}

function do_local_code()
{
    # if the arguments are in the form +LINENO FILE, transform them into --goto FILE:LINENO
    if [ -n "$1" ] && [ "${1:0:1}" == "+" ]
    then
        ARGS=(--goto "$2:${1:1}")
        shift 2
    else
        ARGS=()
    fi
    code --reuse-window "${ARGS[@]}" "$@"
}

function do_local_mac()
{
    if [ "$(emacsclient -e '(seq-some #'"'"'display-graphic-p (frame-list))' 2>/dev/null)" = t ]
    then
        # there is already a GUI frame: bring Emacs to the front and use it
        osascript -e 'tell application "Emacs" to activate'
        emacsclient -n "$@"
    elif emacsclient -e '(version)' &>/dev/null
    then
        # the GUI server is running but has no frame: create a new one
        emacsclient -c -n "$@"
    else
        # start Emacs.app, which starts the server
        open -a Emacs "$@"
    fi
}

function do_remote()
{
    for FILE in "$@"
    do
        case $FILE in
            +*)
                GOTO=$FILE
                ;;
            *)
                FILE=`abspath.py "$FILE"`
                FILE="/ssh:`hostname`:/$FILE"
                local_exec.py e $GOTO "$FILE"
                ;;
        esac
    done
}

if [ -n "$SSH_CONNECTION" ]; then
    do_remote "$@"
elif [ -f /tmp/vscode ]; then
    do_local_code "$@"
else
    if [ "$(uname -s)" = Darwin ]
    then
        do_local_mac "$@"
    else
        do_local "$@"
    fi
fi
