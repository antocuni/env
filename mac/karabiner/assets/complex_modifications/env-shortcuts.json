{
  "title": "env shortcuts",
  "rules": [
    {
      "description": "Option+` : show Emacs (like super+`)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "non_us_backslash",
            "modifiers": {
              "mandatory": [
                "option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "PATH=/opt/homebrew/bin:/usr/bin:/bin $HOME/bin/e"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "grave_accent_and_tilde",
            "modifiers": {
              "mandatory": [
                "option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "PATH=/opt/homebrew/bin:/usr/bin:/bin $HOME/bin/e"
            }
          ]
        }
      ]
    },
    {
      "description": "Menu key or F13 : show kitty (like super.py term)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "application"
          },
          "to": [
            {
              "shell_command": "osascript -e 'tell application \"kitty\" to activate'"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f13"
          },
          "to": [
            {
              "shell_command": "osascript -e 'tell application \"kitty\" to activate'"
            }
          ]
        }
      ]
    },
    {
      "description": "Built-in keyboard: Right Option shows kitty (like super.py term)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "right_option"
          },
          "to_if_alone": [
            {
              "shell_command": "osascript -e 'tell application \"kitty\" to activate'"
            }
          ],
          "to": [
            {
              "key_code": "right_option",
              "lazy": true
            }
          ]
        }
      ]
    }
  ]
}
