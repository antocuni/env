(defun git-mv ()
  "Rename the current buffer's file using `git mv`, and update the buffer accordingly."
  (interactive)
  (let* ((old-path (buffer-file-name)))
    (if (not old-path)
        (error "Current buffer is not visiting a file")
      (let* ((default-name (file-name-nondirectory old-path))
             (new-name (read-file-name "New name: " (file-name-directory old-path) nil nil default-name))
             (new-path (expand-file-name new-name (file-name-directory old-path))))
        ;; Run git mv
        (let ((exit-code (call-process "git" nil "*Git Output*" t "mv" old-path new-path)))
          (if (not (eq exit-code 0))
              (progn
                (switch-to-buffer "*Git Output*")
                (error "git mv failed"))
            ;; Update buffer to visit the new file path
            (set-visited-file-name new-path t t)
            (message "Renamed %s to %s" old-path new-path)))))))





