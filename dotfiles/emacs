;; Magit diff colors, iterated interactively with emacsclient.
;;
;; WHY: with magit's default faces, the "current hunk" highlight was barely
;; distinguishable from the rest of the diff (the highlighted and
;; non-highlighted grays were too similar), and in the dark theme the context
;; lines (grey50 on #202020) were hard to read.
;;
;; The two themes use opposite strategies:
;;
;; - dark (wombat): NO background colors at all, like a plain `git diff` in a
;;   terminal: +/- shown only by the foreground color. The current hunk is
;;   marked by painting a slightly darker bg on it. Since faces are set
;;   globally (set-face-background is not theme-local), switching to light
;;   must undo all of this, hence every face is set in both branches.
;;
;; - light: the classic red/green look, with pastel backgrounds for
;;   added/removed lines, and a pale yellow bg to mark the current hunk.
;;
;; In both themes, the current hunk differs from the others ONLY by its
;; background: the added/removed lines deliberately keep the same colors as
;; non-highlighted hunks.
(defun antocuni-magit-diff-colors-set ()
  (if my-theme-is-dark
      (progn
        ;; normal hunks: default bg, fg colors only
        (set-face-background 'magit-diff-context nil)
        (set-face-foreground 'magit-diff-context "#c8c8c8")
        (set-face-background 'magit-diff-added nil)
        (set-face-foreground 'magit-diff-added "#fad07a")
        (set-face-background 'magit-diff-removed nil)
        (set-face-foreground 'magit-diff-removed "#ff6c6c")
        (set-face-background 'magit-diff-hunk-heading nil)
        (set-face-foreground 'magit-diff-hunk-heading "#909090")
        ;; current hunk: darker bg, same fg colors
        (set-face-background 'magit-diff-context-highlight "#333333")
        (set-face-foreground 'magit-diff-context-highlight "#d4d4d4")
        (set-face-background 'magit-diff-added-highlight "#333333")
        (set-face-foreground 'magit-diff-added-highlight "#fad07a")
        (set-face-background 'magit-diff-removed-highlight "#333333")
        (set-face-foreground 'magit-diff-removed-highlight "#ff6c6c")
        (set-face-background 'magit-diff-hunk-heading-highlight "#454545")
        (set-face-background 'magit-section-highlight "#2a2a2a"))
    ;; light theme: classic red/green diff with bg colors; the fg-only
    ;; "plain" look is only for the dark theme
    (progn
      (set-face-background 'magit-diff-context "white")
      (set-face-foreground 'magit-diff-context "grey50")
      (set-face-background 'magit-diff-added "#ddffdd")
      (set-face-foreground 'magit-diff-added "#22aa22")
      (set-face-background 'magit-diff-removed "#ffdddd")
      (set-face-foreground 'magit-diff-removed "#aa2222")
      (set-face-background 'magit-diff-hunk-heading "grey90")
      (set-face-foreground 'magit-diff-hunk-heading nil)
      (set-face-background 'magit-section-highlight "grey95")
      (set-face-background 'magit-diff-hunk-heading-highlight "#ecd97f")
      (set-face-background 'magit-diff-context-highlight "#fdf7c3")
      (set-face-foreground 'magit-diff-context-highlight "grey50")
      (set-face-background 'magit-diff-added-highlight "#ddffdd")
      (set-face-foreground 'magit-diff-added-highlight "#22aa22")
      (set-face-background 'magit-diff-removed-highlight "#ffdddd")
      (set-face-foreground 'magit-diff-removed-highlight "#aa2222"))))

;; Called both at startup and on every theme switch (see `my-theme-set`
;; above): the colors depend on which theme is currently active. The `facep'
;; check avoids an error if magit is not installed or not yet loaded, since
;; the faces only come into existence when `magit-diff' is loaded.
(with-eval-after-load 'magit-diff
  (antocuni-magit-diff-colors-set))

