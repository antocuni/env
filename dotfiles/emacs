;; diff-hl config: show git diff markers (colored bars) in the fringe/margin
;; of every file buffer. See below for the magit-specific performance hack.
(require 'diff-hl)
(global-diff-hl-mode 1)

(add-hook 'dired-mode-hook #'diff-hl-dired-mode)

;; RET in a diff buffer opens the file in the other window (side-by-side).
;;
;; WHY: magit's default RET (`magit-diff-visit-file') visits "the appropriate
;; version" of the file, i.e. the version of the side of the diff that the
;; line under point belongs to. In an unstaged diff, pressing RET on a
;; *removed* line therefore opens the blob from the index, shown in a virtual
;; buffer named "file.~{index}~", which is useless when you just want to edit
;; the real file.
;;
;; So we use the worktree variants instead: they always open the actual file
;; on disk, and -other-window keeps the diff visible side by side (like
;; `C-x 4 f'), with point moved to the corresponding line.
;; The blob-from-index version is still available via `C-x 4 RET'
;; (magit-diff-visit-file-other-window) when needed.
(with-eval-after-load 'magit-diff
  (define-key magit-diff-section-map (kbd "RET")
    #'magit-diff-visit-worktree-file-other-window))

;; WHY: in magit buffers, C-<tab> is bound to `magit-section-cycle' (cycle
;; section visibility), shadowing the global binding to `other-window'. TAB
;; already toggles sections, so C-<tab> can keep its usual meaning here too.
(with-eval-after-load 'magit-section
  (define-key magit-section-mode-map (kbd "C-<tab>") #'other-window))

;; "C" in magit buffers: commit what I mean.
;;
;; WHY: the magit way to do `git commit -a` requires opening the commit
;; popup, toggling the -a argument, then confirming: too many steps for the
;; most common case. This does the right thing in one keypress:
;; - if something is staged, commit just that (like plain `git commit`);
;; - if nothing is staged, stage all modified tracked files first
;;   (exactly what `git commit -a` does).
;; Note: it shadows `magit-clone`, which is rarely used anyway.
(defun antocuni/magit-commit-dwim ()
  (interactive)
  (if (magit-anything-staged-p)
      (magit-commit-create)
    (magit-commit-create (list "--all"))))

(with-eval-after-load 'magit
  (define-key magit-status-mode-map "C" #'antocuni/magit-commit-dwim)
  (define-key magit-diff-mode-map "C" #'antocuni/magit-commit-dwim)
  ;; Performance: the recommended `diff-hl-magit-post-refresh` hook updates
  ;; the fringe indicators of EVERY open file buffer of the repo, spawning
  ;; one `git diff` process per buffer. With ~40 spy buffers open this took
  ;; ~0.6s on every magit refresh (e.g. after staging a hunk), which made
  ;; magit feel sluggish. So instead:
  ;; - we defer the update to an idle timer: magit commands stay instant;
  ;; - we only update the files which actually appear in the diff buffer
  ;;   (their state can change), not all open buffers;
  ;; - we process them in small chunks (see `antocuni/diff-hl-pump'), so the
  ;;   background update never blocks input for long.
  ;; The fringe may briefly show a stale indicator for up to ~1s, which is an
  ;; acceptable price for a snappy magit.
  (remove-hook 'magit-post-refresh-hook #'diff-hl-magit-post-refresh)
  (add-hook 'magit-post-refresh-hook #'antocuni/diff-hl-magit-post-refresh-idle))

;; Files whose fringe indicator still needs an update, filled by
;; `antocuni/diff-hl-magit-post-refresh-idle' and consumed by the pump below.
(defvar antocuni/diff-hl-pending-files nil)

(defun antocuni/diff-hl-magit-post-refresh-idle ()
  "Like `diff-hl-magit-post-refresh', but deferred and cheap.
Runs on an idle timer (so it does not block the magit command
which triggered it), and only updates the buffers visiting the
files shown in the magit diff buffer. Files are deduplicated here
because the same file typically appears both in the \"Staged
changes\" and \"Unstaged changes\" sections."
  (setq antocuni/diff-hl-pending-files
        (delete-dups (antocuni/diff-hl--collect-magit-files)))
  (antocuni/diff-hl-pump))

(defun antocuni/diff-hl--collect-magit-files ()
  "Return the file names shown in all magit diff buffers."
  (let ((files nil))
    (dolist (buf (buffer-list))
      (when (with-current-buffer buf (derived-mode-p 'magit-diff-mode))
        (setq files
              (append files
                      (antocuni/diff-hl--collect-file-names
                       ;; magit-root-section is the tree of sections displayed
                       ;; by the magit buffer (files, hunks, ...)
                       (with-current-buffer buf magit-root-section))))))
    files))

(defun antocuni/diff-hl--collect-file-names (section)
  "Return the file names of SECTION and its children, recursively."
  (when section
    (let ((files nil))
      (when (magit-file-section-p section)
        (push (oref section value) files))
      (dolist (child (oref section children))
        (setq files (append (antocuni/diff-hl--collect-file-names child) files)))
      files)))

(defun antocuni/diff-hl-pump ()
  "Update diff-hl indicators for a few pending files, then reschedule.
Each `diff-hl-update' spawns a git subprocess (~50ms); doing all
of them in one go would freeze input for about a second, so we
process 3 at a time and reschedule on the idle timer until done.
Any keystroke makes Emacs non-idle and postpones the next chunk,
so the pump never gets in the way."
  (let ((topdirs (make-hash-table :test 'equal))
        (n 0))
    (while (and antocuni/diff-hl-pending-files (< n 3))
      (let* ((file (pop antocuni/diff-hl-pending-files))
             ;; cache magit-toplevel: it also spawns a git process, and all
             ;; files in this queue typically belong to the same repo
             (topdir (gethash file topdirs)))
        (unless topdir
          (setq topdir (magit-toplevel))
          (puthash file topdir topdirs))
        ;; update the fringe only if we have the file open in a buffer;
        ;; files which are not being edited don't need it
        (let ((fbuf (find-buffer-visiting (expand-file-name file topdir))))
          (when fbuf
            (with-current-buffer fbuf (diff-hl-update)))))
      (setq n (1+ n)))
    (when antocuni/diff-hl-pending-files
      (run-with-idle-timer 0.15 nil #'antocuni/diff-hl-pump))))

